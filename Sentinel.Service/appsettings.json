{
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "Sentinel": {
    "PollIntervalSeconds": 30,
    "LogPath": "C:\\Logs\\Sentinel",
    "Resources": {
      "CpuPercentThreshold": 85.0,
      "RamPercentThreshold": 97.0,
      "DiskFreePercentThreshold": 10.0,
      "MonitoredDrives": [ "C:\\" ]
    },
    "Network": {
      "PingTargets": [ "8.8.8.8", "1.1.1.1", "10.10.3.100", "10.10.3.101" ],
      "LatencyThresholdMs": 200
    },
    "FileSystem": {
      "WatchPaths": [ "C:\\Users\\kmorrow\\Downloads", "C:\\Users\\kmorrow\\scripts" ],
      "IncludeSubdirectories": true
    },
    "EventLog": {
      "LogNames": [ "System", "Application" ]
    },
    "SignalDaemon": {
      "Enabled": true,
      "BlocklistDbPath": "C:\\Sentinel\\signaldaemon_blocklist.sqlite",
      "DetectionsDbPath": "C:\\Logs\\Sentinel\\detections.sqlite",
      "MatchLogPath": "C:\\Logs\\Sentinel\\matches.log",
      "Scan": {
        "OnlyEstablished": true,
        "ExternalOnly": true,
        "LogAllBaselines": false,
        "DedupeBaselineSession": true,
        "SeverityThreshold": "High",
        "LogBaselines": false
      },
      "Notify": {
        "Enabled": true,
        "MinSeverity": "Medium",
        "Categories": [ "OS_Telemetry", "App_Telemetry", "Surveillance", "Malicious"],
        "SquelchSeconds": 180
      }
    }
  }
}